# Copy to .env for local development. Nothing here is required to run locally.

# local | preview | production. "local" enables the dev sign-in and the Reseed button.
APP_ENV=local
# Leave unset locally to use ./jokebox.db (SQLite). On Vercel this is the Neon Postgres URL.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Signs the session cookie. On Vercel: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=local-dev-secret-change-me
# Google accounts allowed to sign in, comma-separated.
ALLOWED_EMAILS=you@example.com
# From Google Cloud Console > APIs & Services > Credentials > OAuth client (Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public origin used for the Google redirect, e.g. https://jokebox.samarthsaraswat.com
PUBLIC_URL=http://localhost:5173
